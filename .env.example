# rpmc-superops-mcp environment sample
# Copy to a private location (never commit real values). Production values live on QNAP.

MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# Required for HTTP (min 32 characters). Callers send: Authorization: Bearer <this value>
# Not required for stdio.
MCP_AUTH_TOKEN=replace-with-a-long-random-token-min-32-chars

# Optional. Used when a client sends Origin (browsers). Comma-separated origins or hostnames.
# Leave unset for loopback-only Origin allowance. Non-browser clients that omit Origin still work.
# If MCP_ALLOWED_HOSTS is unset, Host validation reuses these hostnames.
# Example for a future Cloudflare Access hostname (do not hardcode in source):
# MCP_ALLOWED_ORIGINS=https://your-tunnel-hostname.example
# MCP_ALLOWED_HOSTS=your-tunnel-hostname.example

# SuperOps MSP API (container env only; never send these to MCP callers)
SUPEROPS_API_TOKEN=replace-with-superops-token
SUPEROPS_SUBDOMAIN=your-subdomain
SUPEROPS_REGION=us

# Optional
SUPEROPS_REQUEST_TIMEOUT_MS=30000
SUPEROPS_MAX_READ_RETRIES=3
LOG_LEVEL=info
